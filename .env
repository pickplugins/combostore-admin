# NEXT_PUBLIC_SERVER_URL=http://localhost/wp/
# NEXT_PUBLIC_APP_URL=http://localhost:3000/

NEXT_PUBLIC_SERVER_URL=https://server.combostore.bd/
NEXT_PUBLIC_APP_URL=https://combostore.bd/

NEXT_PUBLIC_APP_VERSION=0.1.0


# Paddle Billing (client side). The client token is a publishable key - the
# secret key belongs on the WordPress side, which is where webhooks land.
# Leave PADDLE_ENV as sandbox until the live prices are ready: an unset value
# also means sandbox, so nothing here can charge a real card by accident.
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=m30sj614t7r792005dm0e147gt69zws1tx0w1as44kj45bm1wd
# The two ComboStore subscriptions, as Paddle price ids (pri_...).
NEXT_PUBLIC_PADDLE_PRICE_STARTER=931087
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=931094
