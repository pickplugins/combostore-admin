# NEXT_PUBLIC_SERVER_URL=http://localhost/wp/
# NEXT_PUBLIC_APP_URL=http://localhost:3000/

NEXT_PUBLIC_SERVER_URL=https://server.combostore.bd/
NEXT_PUBLIC_APP_URL=https://combostore.bd/

NEXT_PUBLIC_APP_VERSION=0.1.0


# Lemon Squeezy. No publishable key: a checkout link is the whole front-end
# credential, so paste each product's link from its Share panel in the Lemon
# Squeezy dashboard. The API key stays on the WordPress side, with the webhook.
# MODE only decides whether the plan step warns that real cards are in play -
# test or live follows the store and the links themselves. It defaults to test.
NEXT_PUBLIC_LEMONSQUEEZY_MODE=test
NEXT_PUBLIC_LEMONSQUEEZY_LINK_STARTER=https://combostore.lemonsqueezy.com/checkout/buy/007fd578-cbe2-40e8-930b-784f4c5052ae?embed=1
NEXT_PUBLIC_LEMONSQUEEZY_LINK_BUSINESS=https://combostore.lemonsqueezy.com/checkout/buy/4563afee-8a7e-4bdd-9a69-f3533edf58ca?embed=1

# Paddle, retired in favour of Lemon Squeezy. Kept commented rather than
# deleted so the account is recoverable if the decision is revisited.
